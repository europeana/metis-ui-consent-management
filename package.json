{
  "name": "@europeana/metis-ui-consent-management",
  "version": "0.0.1",
  "scripts": {
    "ng": "ng",
    "build": "rm -rf ./dist && ng build",
    "clean": "rm -rf ./dist && rm -rf ./projects/**/dist && rm -rf ./projects/**/coverage",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:dev": "jest --collect-coverage",
    "publish-dry": "npm publish dist/metis-ui-consent-management/ --access=public --dry-run --verbose",
    "publish-lib": "npm publish dist/metis-ui-consent-management/ --access=public",
    "prettier": "prettier --trailing-comma none --write './**/*.{ts,html}'",
    "prettier:ci": "prettier --list-different './**/*.{ts,html}'",
    "lint": "eslint projects/metis-ui-consent-management --fix",
    "lint:ci": "eslint projects/metis-ui-consent-management"
  },
  "private": false,
  "dependencies": {
    "@angular-builders/jest": "^20.0.0",
    "@angular/common": "^20.3.18",
    "@angular/compiler": "^20.3.18",
    "@angular/core": "^20.3.18",
    "@angular/forms": "^20.3.18",
    "@angular/platform-browser": "^20.3.18",
    "@angular/platform-browser-dynamic": "^20.3.18",
    "@angular/router": "^20.3.18",
    "@typescript-eslint/eslint-plugin": "^8.44.0",
    "eslint": "^9.20.1",
    "ngx-cookie-service": "^20.1.1",
    "prettier": "^3.1.0",
    "rxjs": "^7.5.5",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.22",
    "@angular/cli": "^20.3.22",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.20.0",
    "@stylistic/eslint-plugin": "^4.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^12.20.37",
    "globals": "^15.15.0",
    "jasmine": "^5.1.0",
    "jasmine-core": "~3.8.0",
    "jest": "^29.7.0",
    "ng-packagr": "^20.3.2",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "jasmine": "^5.1.0"
  }
}
